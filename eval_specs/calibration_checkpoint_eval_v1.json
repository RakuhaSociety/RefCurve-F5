  "texts": [
    {
      "id": "core_narr_01",
      "split": "core",
      "category": "narration",
      "text_original": "今日は空がとても澄み渡っていて、遠くの山並みまではっきりと見えた。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": true,
      "leakage_status": null,
      "notes": "普通叙述 1"
    },
    {
      "id": "core_narr_02",
      "split": "core",
      "category": "narration",
      "text_original": "彼女は静かに本を閉じて、窓の外に広がる夜景をしばらく眺めていた。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": true,
      "leakage_status": null,
      "notes": "普通叙述 2"
    },
    {
      "id": "core_conv_01",
      "split": "core",
      "category": "conversational",
      "text_original": "えっと、それって本当に大丈夫なの？もう少し教えてもらえる？",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": true,
      "leakage_status": null,
      "notes": "自然な疑問表現 1"
    },
    {
      "id": "core_conv_02",
      "split": "core",
      "category": "conversational",
      "text_original": "ねえ、聞いてた？さっきの話、ちゃんと伝わったかな。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": true,
      "leakage_status": null,
      "notes": "短い対話的発言 2"
    },
    {
      "id": "core_emo_hi_01",
      "split": "core",
      "category": "emotion_high",
      "text_original": "やっぱりそうか！ずっと待ってたんだよ、こういう日を！本当によかった！",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_expressive",
      "human_listening": true,
      "leakage_status": null,
      "notes": "高アローザル 喜び・興奮"
    },
    {
      "id": "core_emo_lo_01",
      "split": "core",
      "category": "emotion_low",
      "text_original": "……もう、どうしたらいいんだろ。これ以上続けるのが怖くて。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_soft",
      "human_listening": true,
      "leakage_status": null,
      "notes": "低アローザル 不安・弱音"
    },
    {
      "id": "core_num_01",
      "split": "core",
      "category": "numbers",
      "text_original": "先月の売り上げは二百三十七万円で、前月比で約十二パーセント増加しました。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": true,
      "leakage_status": null,
      "notes": "数字・金額・割合"
    },
    {
      "id": "core_num_02",
      "split": "core",
      "category": "numbers",
      "text_original": "待ち合わせは十二月二十五日の午後三時半、渋谷の改札口で。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": true,
      "leakage_status": null,
      "notes": "日付・時刻"
    },
    {
      "id": "core_loan_01",
      "split": "core",
      "category": "loanwords",
      "text_original": "ノートパソコンのバッテリーがフル充電になるまで、だいたい一時間半かかる。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": true,
      "leakage_status": null,
      "notes": "外来語・長音"
    },
    {
      "id": "core_loan_02",
      "split": "core",
      "category": "loanwords",
      "text_original": "ミルクティーとショートケーキのセットで、合計千百二十円になります。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": true,
      "leakage_status": null,
      "notes": "外来語 + 数字 + 助数詞"
    },
    {
      "id": "robust_long_01",
      "split": "robustness",
      "category": "long",
      "text_original": "彼女が廊下の端に立っているのを見つけたとき、私はすぐに何か変だと感じたのだが、その直感を確かめる勇気がなかなか出なかった。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": false,
      "leakage_status": null,
      "notes": "長文 複数節"
    },
    {
      "id": "robust_punct_01",
      "split": "robustness",
      "category": "punctuation",
      "text_original": "「え……本当に？」と彼女は呟いて、「それって、つまり……そういうことなの？」と続けた。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": false,
      "leakage_status": null,
      "notes": "会話記号・三点リーダー・疑問符混在"
    },
    {
      "id": "robust_num_dense_01",
      "split": "robustness",
      "category": "number_dense",
      "text_original": "第三章の第七節、百八十二ページから百九十五ページの内容を三十分以内にまとめること。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": false,
      "leakage_status": null,
      "notes": "数字密集 連続する数字読み"
    },
    {
      "id": "robust_kata_dense_01",
      "split": "robustness",
      "category": "katakana_dense",
      "text_original": "コンシューマーゲームのローンチタイトルとして、オープンワールドRPGがリリースされる予定だ。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": false,
      "leakage_status": null,
      "notes": "片仮名密集"
    },
    {
      "id": "robust_geminate_01",
      "split": "robustness",
      "category": "geminate_long_vowel",
      "text_original": "コップについた水滴がテーブルに落ちた瞬間、彼女はハッとして思わず立ち止まった。",
      "text_kana": null,
      "text_kana_sha256": null,
      "reference_id": "ref_neutral",
      "human_listening": false,
      "leakage_status": null,
      "notes": "促音・長音・混在"
